{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "rootDirectory": "dashboard",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/v1/:path*",
      "destination": "https://${NETRA_BACKEND_HOST:-gateway.netra.internal}/v1/:path*"
    },
    {
      "source": "/admin/:path*",
      "destination": "https://${NETRA_BACKEND_HOST:-gateway.netra.internal}/admin/:path*"
    },
    {
      "source": "/health",
      "destination": "https://${NETRA_BACKEND_HOST:-gateway.netra.internal}/health"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}

