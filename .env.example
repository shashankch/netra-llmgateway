# ==============================================================================
# NETRA LLM Gateway — Enterprise Environment Configuration (.env.example)
#
# INSTRUCTIONS:
# 1. Copy this file to '.env':
#    cp .env.example .env
# 2. Configure active profile:
#    - 'SPRING_PROFILES_ACTIVE=dev' for local mock drills & evaluation scripts.
#    - 'SPRING_PROFILES_ACTIVE=prod' for live production with OpenRouter / In-VPC.
# 3. NEVER commit your actual '.env' file to Git. (.env is in .gitignore).
# ==============================================================================

# ------------------------------------------------------------------------------
# 0. Active Spring Boot Profile
# ------------------------------------------------------------------------------
# Options: 'dev' (local mock alpha/beta providers) or 'prod' (production enterprise)
SPRING_PROFILES_ACTIVE=dev

# ------------------------------------------------------------------------------
# 1. Upstream AI Providers & Credentials
# ------------------------------------------------------------------------------
# Q: Why can you set either OPENROUTER_API_KEY or OPENAI_API_KEY?
# A: OpenRouter uses the exact OpenAI wire specification (/v1/chat/completions).
#    NETRA seamlessly unifies them: if you set OPENROUTER_API_KEY, NETRA routes
#    all 500+ frontier models through OpenRouter. If you prefer pointing to direct
#    OpenAI (api.openai.com) or an internal proxy, set OPENAI_API_KEY and OPENAI_BASE_URL.
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional direct OpenAI credentials (if bypassing OpenRouter aggregator for direct billing):
# OPENAI_API_KEY=sk-proj-your-openai-key-here
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional In-VPC Private Endpoints (e.g. self-hosted vLLM or Ollama on private network):
# VLLM_BASE_URL=http://vllm.internal.vpc:8000/v1
# VLLM_API_KEY=EMPTY

# Local mock providers (active under 'dev' profile for offline smoke tests & benchmark drills):
ALPHA_PROVIDER_URL=http://localhost:9001/v1
ALPHA_PROVIDER_API_KEY=mock-key-alpha
BETA_PROVIDER_URL=http://localhost:9002/v1
BETA_PROVIDER_API_KEY=mock-key-beta

# ------------------------------------------------------------------------------
# 2. Dynamic Model Aliases & Multi-Fallback Routing Chains
# ------------------------------------------------------------------------------
# Clients send 'model: "fast"', 'model: "smart"', or 'model: "auto"'.
#
# MULTI-FALLBACK CONFIGURATION:
# Provide comma-separated fallbacks: e.g. "fallback_1, fallback_2, fallback_3"
#
# RESOLVING IN-VPC vs OPENROUTER AMBIGUITY:
# If you host a model (e.g. Llama 3.3) locally AND it also exists on OpenRouter,
# disambiguate with explicit provider prefixes:
#   Primary:   vllm-local:meta-llama/llama-3.3-70b-instruct
#   Fallback:  openrouter:meta-llama/llama-3.3-70b-instruct
#
# --- SCENARIO A: Local Offline Mock Mode (Profile: dev) ---
# NETRA_MODEL_ALIASES_FAST_PRIMARY=alpha-small
# NETRA_MODEL_ALIASES_FAST_FALLBACK=beta-small
# NETRA_MODEL_ALIASES_SMART_PRIMARY=alpha-large
# NETRA_MODEL_ALIASES_SMART_FALLBACK=beta-large
#
# --- SCENARIO B: Live Production via OpenRouter (Profile: prod — 2026 Recommended) ---
# Fast Tier: Ultra-fast TTFT (<150ms), sub-$0.20/1M tok (chat, extraction, summaries)
# NETRA_MODEL_ALIASES_FAST_PRIMARY=google/gemini-2.0-flash-001
# NETRA_MODEL_ALIASES_FAST_FALLBACK=openai/gpt-4o-mini,deepseek/deepseek-chat
#
# Smart Tier: Deep deliberative chain-of-thought, code synthesis & complex proofs
# NETRA_MODEL_ALIASES_SMART_PRIMARY=anthropic/claude-3.5-sonnet
# NETRA_MODEL_ALIASES_SMART_FALLBACK=openai/o3-mini,deepseek/deepseek-r1
#
# --- SCENARIO C: Hybrid In-VPC + OpenRouter Fallback ---
# NETRA_MODEL_ALIASES_FAST_PRIMARY=vllm-local:meta-llama/llama-3.3-70b-instruct
# NETRA_MODEL_ALIASES_FAST_FALLBACK=openrouter:meta-llama/llama-3.3-70b-instruct,openrouter:deepseek/deepseek-chat
# NETRA_MODEL_ALIASES_SMART_PRIMARY=vllm-local:deepseek/deepseek-r1
# NETRA_MODEL_ALIASES_SMART_FALLBACK=openrouter:anthropic/claude-3.5-sonnet

# ------------------------------------------------------------------------------
# 3. Gateway Core Server
# ------------------------------------------------------------------------------
SERVER_PORT=8080
NETRA_ADMIN_TOKEN=netra-admin-demo
NETRA_DATA_PATH=data

# ------------------------------------------------------------------------------
# 4. PostgreSQL Database (pgvector)
# ------------------------------------------------------------------------------
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/netra_gateway
SPRING_DATASOURCE_USERNAME=netra
SPRING_DATASOURCE_PASSWORD=netra

# ------------------------------------------------------------------------------
# 5. Redis (Atomic Admission & Sliding-Window Quotas)
# ------------------------------------------------------------------------------
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379

# ------------------------------------------------------------------------------
# 6. Currency & Forex Configuration
# ------------------------------------------------------------------------------
NETRA_CURRENCY_FALLBACK_USD_TO_INR=85.00
NETRA_CURRENCY_CACHE_TTL_HOURS=6
